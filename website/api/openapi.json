		"/dns/query": {
			"get": {
				"tags": ["域名查询"],
				"operationId": "dnsQuery",
				"parameters": [
					{
						"name": "name",
						"in": "query",
						"required": true,
						"description": "要查询的域名.",
						"schema": {
							"type": "string",
							"example": "example.com"
						}
					},
					{
						"name": "type",
						"in": "query",
						"required": false,
						"description": "记录类型，如 A、AAAA、TXT 等.",
						"schema": {
							"type": "string",
							"example": "A"
						}
					}
				],
				"responses": {
					"200": {
						"description": "DNS 查询结果.",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"additionalProperties": true
								},
								"example": {
									"Status": 0,
									"Question": [
										{
											"Name": "example.com.",
											"Qtype": 1,
											"Qclass": 1
										}
									],
									"Answer": [
										{
											"TTL": 274,
											"data": "104.20.23.154",
											"name": "example.com.",
											"type": 1
										}
									],
									"RA": true,
									"RD": true,
									"AD": false,
									"CD": false,
									"TC": false
								}
							}
						}
					}
				},
				"summary": "DNS 查询",
				"description": "获取指定名称和类型的 DNS 查询数据.必填 query：name、type（如 A）."
			}
		},
